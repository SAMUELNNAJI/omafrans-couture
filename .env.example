# Copy this file to .env for local development.
# Never commit the real .env to git.

DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (leave blank to use SQLite locally)
DATABASE_URL=

# Render sets this automatically in production — do not set manually
# RENDER_EXTERNAL_HOSTNAME=
